RewriteEngine On

# Root → serve mona-shelly-site as homepage
RewriteRule ^$ mona-shelly-site.html [L]

# Redirect old pages to coaching
RewriteRule ^offers(\.html)?$ /coaching [R=301,L]
RewriteRule ^cohort(\.html)?$ /coaching [R=301,L]
RewriteRule ^work-with-me(\.html)?$ /coaching [R=301,L]

# Redirect /page.html → /page (strip .html from URL)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve clean URLs — /page → page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]
